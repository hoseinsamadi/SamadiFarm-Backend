# This file is only a production checklist. Put real values in the host's .env.
DJANGO_DEBUG=False
DOMAIN=your-domain.ir
POSTGRES_PASSWORD=use-a-long-random-password-here
ADMIN_URL=manage-a-long-random-private-path
