{$DOMAIN:localhost} {
    encode zstd gzip

    handle_path /static/* {
        root * /app/backend/staticfiles
        file_server
    }

    handle_path /media/* {
        root * /data/media
        file_server
    }

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle /{$ADMIN_URL:admin}/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
